    { "id": "plan", "lane": "planning", "col": 2, "type": "cloud", "label": "Plan", "sublabel": "static parameters", "width": 120 },
    { "id": "partition", "lane": "control", "col": 3, "type": "messagebus", "label": "Partition", "sublabel": "immutable tasks", "width": 120 },
    { "id": "dispatch", "lane": "scheduler", "col": 4, "type": "cloud", "label": "Dispatch", "sublabel": "Slurm · K8s · Local", "width": 128 },
    { "id": "parts", "lane": "workers", "col": 5, "type": "backend", "label": "Convert Parts", "sublabel": "parallel + retryable", "width": 128 },
    { "id": "assemble", "lane": "control", "col": 5, "type": "database", "label": "Assemble", "sublabel": "episode order", "width": 120 },
