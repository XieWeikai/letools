    { "id": "execute", "label": "Execute", "fromCol": 3, "toCol": 4 },
    { "id": "finish", "label": "Accept", "fromCol": 5, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["request", "inspect", "plan", "partition", "dispatch", "parts", "assemble", "validate", "publish"],
  "semanticChecks": {
