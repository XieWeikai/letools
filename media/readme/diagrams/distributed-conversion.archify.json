  "meta": {
    "title": "Distributed Conversion Workflow",
    "quality_profile": "showcase",
    "views": [
      { "id": "plan", "label": "Plan", "focus": ["request", "inspect", "plan"], "note": "Inspect the dataset and effective resource limits before any conversion work starts." },
